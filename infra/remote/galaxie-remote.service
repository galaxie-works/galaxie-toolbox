[Unit]
Description=GALAXIE Remote signaling and TURN
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/docker/galaxie-remote
ExecStart=/usr/bin/docker compose up -d --build --remove-orphans
ExecReload=/usr/bin/docker compose up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=900
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
