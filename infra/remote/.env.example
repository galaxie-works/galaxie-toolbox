GALAXIE_REMOTE_PUBLIC_IP=145.223.94.149
GALAXIE_REMOTE_REALM=telemetry.thegalaxie.cloud

# A imagem do signaling. ORIGEM: o job `publish-signaling` do ci.yml (#1312 §5) publica
# `ghcr.io/galaxie-works/galaxie-remote-signaling:<SHA>` a cada push na `pre-prod`. O host
# escolhe qual tag/`@sha256:<digest>` deployar (deploy = escolher uma tag). O `:local`
# abaixo é só o fallback de DEV (build local); em produção põe a tag-SHA (ou o digest).
GALAXIE_REMOTE_IMAGE=ghcr.io/galaxie-works/galaxie-remote-signaling:local

# Contexto do build LOCAL (dev). A produção NÃO compila — puxa a imagem acima (#1307/§4).
GALAXIE_REMOTE_BUILD_CONTEXT=../..

# PULL da imagem PRIVADA no host (#1312 §4a / cond. 2 do @Altair): o pacote é privado, então
# o `docker login ghcr.io` no host precisa de um PAT fine-grained, READ-ONLY, escopado a
# ESTE pacote, com expiração. O VALOR nunca vive no repo — vive no `.env` do host (modo
# 0600); aqui só a CHAVE, sem valor. O PUSH do CI NÃO usa isto (usa o `GITHUB_TOKEN`).
GHCR_PULL_TOKEN=
