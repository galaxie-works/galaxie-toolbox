GALAXIE_REMOTE_PUBLIC_IP=145.223.94.149
GALAXIE_REMOTE_REALM=telemetry.thegalaxie.cloud

# A imagem do signaling. Este default é o build LOCAL de DEV — nome NU, sem `ghcr.io/`:
# `galaxie-remote-signaling:local` nunca é puxado dum registry, é o que o `docker compose
# build` cria na tua máquina. Em PRODUÇÃO, o host SOBRESCREVE isto com a imagem imutável que
# o job `publish-signaling` do ci.yml (#1312 §5) publica a cada push na `pre-prod`:
#   GALAXIE_REMOTE_IMAGE=ghcr.io/galaxie-works/galaxie-remote-signaling@sha256:<digest>
# 🔑 Regra (@Altair, cond.3): `ghcr.io/…` SÓ com SHA/digest IMUTÁVEL — NUNCA `ghcr.io/…:local`
# (tag mutável, e a que o CI nem publica: um `pull` dela falharia, e "publicar um :local" pra
# consertar seria criar a tag mutável que a proveniência existe pra impedir).
GALAXIE_REMOTE_IMAGE=galaxie-remote-signaling:local

# Contexto do build LOCAL (dev). A produção NÃO compila — puxa a imagem acima (#1307/§4).
GALAXIE_REMOTE_BUILD_CONTEXT=../..

# PULL da imagem PRIVADA no host (#1312 §4a / cond. 2 do @Altair): o pacote é privado, então
# o `docker login ghcr.io` no host precisa de um PAT fine-grained, READ-ONLY, escopado a
# ESTE pacote, com expiração. O VALOR nunca vive no repo — vive no `.env` do host (modo
# 0600); aqui só a CHAVE, sem valor. O PUSH do CI NÃO usa isto (usa o `GITHUB_TOKEN`).
GHCR_PULL_TOKEN=
