# OpenObserve — chaves esperadas no host (valores NUNCA entram no repo).
# CONFERIDO CONTRA O HOST em 2026-08-24 (altair, #1307).
#
# O esqueleto anterior (#1311) trazia ZO_DATA_DIR e ZO_HTTP_PORT: nenhuma das
# duas existe no host. Os dados ficam num volume nomeado (`openobserve_data`) e
# a porta 5080 está fixa no label do Traefik. Removidas.

# Credenciais do usuário raiz (criadas no primeiro boot).
ZO_ROOT_USER_EMAIL=
ZO_ROOT_USER_PASSWORD=

# `TRAEFIK_HOST` REMOVIDA do host e daqui (#1480 AC4, altair 2026-08-25). Era
# resquício da era pré-domínio: o compose antigo montava a regra como
# `Host(${COMPOSE_PROJECT_NAME}.${TRAEFIK_HOST})`; o atual escreve
# `telemetry.thegalaxie.cloud` direto no label. Conferido antes de remover: a
# chave só aparecia num arquivo `.before-*`, em nenhuma configuração ativa.
# Chave morta engana — quem a encontrasse mudaria o valor e nada aconteceria.
