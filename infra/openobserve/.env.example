# OpenObserve — chaves esperadas no host (valores NUNCA entram no repo).
# #1311: esqueleto. O compose real ainda não foi conferido contra a VPS —
# ver o aviso em ../README.md antes de assumir que isto é o que roda.

# Credenciais do usuário raiz (criadas no primeiro boot).
ZO_ROOT_USER_EMAIL=
ZO_ROOT_USER_PASSWORD=

# Onde os dados ficam no HOST (volume persistente).
ZO_DATA_DIR=

# Porta publicada (o Traefik roteia para cá).
ZO_HTTP_PORT=5080
