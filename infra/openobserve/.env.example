# OpenObserve — chaves esperadas no host (valores NUNCA entram no repo).
# CONFERIDO CONTRA O HOST em 2026-08-24 (altair, #1307).
#
# O esqueleto anterior (#1311) trazia ZO_DATA_DIR e ZO_HTTP_PORT: nenhuma das
# duas existe no host. Os dados ficam num volume nomeado (`openobserve_data`) e
# a porta 5080 está fixa no label do Traefik. Removidas.

# Credenciais do usuário raiz (criadas no primeiro boot).
ZO_ROOT_USER_EMAIL=
ZO_ROOT_USER_PASSWORD=

# ⚠️ Presente no `.env` do host e NÃO usada pelo compose: o Host das rotas está
# escrito direto no label (`telemetry.thegalaxie.cloud`). Mantida aqui porque a
# chave existe lá — não porque tenha efeito. Removê-la do host é mudança de
# produção e vai em card próprio.
TRAEFIK_HOST=
