# Traefik — chaves esperadas no host (valores NUNCA entram no repo).
# #1311: esqueleto. O compose real ainda não foi conferido contra a VPS —
# ver o aviso em ../README.md antes de assumir que isto é o que roda.

# Domínio base das rotas publicadas.
TRAEFIK_DOMAIN=

# E-mail do ACME/Let's Encrypt (emissão e renovação de certificado).
TRAEFIK_ACME_EMAIL=

# Caminho do storage do ACME no HOST (montado read-write; contém chave privada).
TRAEFIK_ACME_STORAGE=

# Nível de log: DEBUG|INFO|WARN|ERROR. Produção usa INFO ou acima.
TRAEFIK_LOG_LEVEL=INFO
