{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GALAXIE Toolbox",
  "version": "0.30.0",
  "identifier": "works.galaxie.toolbox",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GALAXIE",
        "width": 800,
        "height": 600,
        "minWidth": 600,
        "minHeight": 400,
        "center": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#09090B",
        "dragDropEnabled": false
      },
      {
        "label": "splashscreen",
        "url": "index.html?splash=1",
        "width": 400,
        "height": 400,
        "center": true,
        "visible": true,
        "transparent": false,
        "backgroundColor": "#171A30",
        "decorations": false,
        "resizable": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true,
    "publisher": "Galaxie Works",
    "copyright": "Galaxie Works",
    "category": "Business",
    "shortDescription": "Ferramentas de Microsoft 365 e Windows",
    "longDescription": "Conecta as bibliotecas do SharePoint ao OneDrive do usuario e reune ferramentas de apoio ao Microsoft 365."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/galaxie-works/galaxie-toolbox-releases/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBNDZDMkZEQzQ5MjcwQzkKUldUSmNKTEUvY0pHT2hobXY5SS92U1Zyd05BSjgyZjV2MURqNHV3dC8yVmF1M1JrSURGZGUxQ1YK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
